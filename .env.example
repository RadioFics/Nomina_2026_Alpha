# ============================================================================
# CONFIGURACIÓN EJEMPLO - BASE DE DATOS SQL SERVER
# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores con tus credenciales reales
# 3. Asegúrate de no compartir el .env con credenciales reales
# ============================================================================

# Servidor SQL Server
# Opción 1: Usar hostname (solo funciona en la red local)
#   SERVER=CM-ITD-P-05\SQLEXPRESS
#
# Opción 2: Usar IP (recomendado para escalabilidad)
#   Para obtener la IP: nslookup CM-ITD-P-05 (en PowerShell)
#   SERVER=192.168.1.100\SQLEXPRESS
#
# Opción 3: Usar dominio (ideal para producción)
#   SERVER=servidor.empresa.com\SQLEXPRESS
#
SERVER=AQUI_TU_SERVIDOR_SQL

# Nombre de la base de datos
DATABASE=MineDax

# Usuario de SQL Server (no usar 'sa' en producción)
UID=TU_USUARIO_SQL

# Contraseña de SQL Server
PWD=TU_CONTRASEÑA_SQL

# Driver ODBC (dejar como está)
DRIVER=ODBC Driver 17 for SQL Server

# ============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================================

# Puerto de la aplicación
PORT=3000

# Ambiente
NODE_ENV=development

# Clave JWT (cambiar en producción a una cadena aleatoria de 32+ caracteres)
JWT_SECRET=clave-super-segura-cambiar-en-produccion-minimo-32-caracteres-aleatorios

# ============================================================================
# CONFIGURACIÓN DE EMAIL (Opcional)
# ============================================================================

MAIL_USER=tu-email@gmail.com
MAIL_PASS=tu-contraseña-de-aplicacion
APP_URL=http://localhost:3000

# Correo de destino para notificaciones de RRHH (formularios públicos de permiso/vacaciones)
MAIL_RRHH=talento.humano@collectivemining.com

# ============================================================================
# DOMINIOS DE EMAIL PERMITIDOS PARA REGISTRO PROPIO
# ============================================================================
# Lista separada por comas. Solo los correos de estos dominios pueden
# auto-registrarse desde el formulario de "Crear cuenta".
# Si se deja vacío, se permite cualquier dominio (modo abierto — NO recomendado
# para producción).
# Ejemplo: ALLOWED_EMAIL_DOMAINS=collectivemining.com,adecco.com
ALLOWED_EMAIL_DOMAINS=collectivemining.com

# ============================================================================
# SHAREPOINT — Guardado automático de PDFs de solicitudes
# ============================================================================
# Si estas variables están presentes, los PDFs de permiso y vacaciones se
# guardarán automáticamente en la carpeta de SharePoint indicada.
# Si se omiten, el flujo continúa normalmente (solo correo, sin SharePoint).
#
# Cómo obtener estos valores:
#   1. Portal Azure → Azure AD → Registros de aplicaciones → Nueva registro
#   2. Permisos API → Microsoft Graph → Sites.ReadWrite.All (o Files.ReadWrite.All)
#   3. Certificados y secretos → Nuevo secreto de cliente
#   4. SP_DRIVE_ID: Graph Explorer → GET /v1.0/sites/{site-id}/drives → copiar "id"
#      O usa: https://developer.microsoft.com/en-us/graph/graph-explorer

# ============================================================================
# APROBACIÓN INTERMEDIA — JEFES DE ÁREA (Opción A)
# ============================================================================
# Antes de que un formulario de Permiso o Vacaciones se registre en MineDax,
# el jefe del área del empleado debe aprobarlo por correo.
#
# Cómo configurar:
#   1. Identifica el COD_CCOST de cada área en dbo.MAE_CCOST.
#   2. Agrega una variable JEFE_CCOST_{cod}=correo@dominio.com por cada área.
#   3. Opcionalmente, agrega JEFE_CCOST_{cod}_NOMBRE=Nombre Jefe.
#   4. JEFE_DEFAULT es el fallback cuando el empleado no tiene CC asignado.
#
# Ejemplo (reemplaza los COD_CCOST con los de tu instancia de MineDax):
#   JEFE_CCOST_1=gerencia@collectivemining.com
#   JEFE_CCOST_1_NOMBRE=Director General
#   JEFE_CCOST_5=logistica@collectivemining.com
#   JEFE_CCOST_5_NOMBRE=Jefe de Logística
#   JEFE_CCOST_12=mineria@collectivemining.com
#   JEFE_CCOST_12_NOMBRE=Superintendente de Minería
#
# Si NO se configura ninguna variable → usa MAIL_RRHH como jefe (TH aprueba todo).
JEFE_DEFAULT=talento.humano@collectivemining.com
JEFE_DEFAULT_NOMBRE=Talento Humano

# Horas que tiene el jefe para responder antes de que expire el enlace (def: 72)
JEFE_TOKEN_HORAS=72

# Cada cuántas horas se envía un recordatorio si no hay respuesta (def: 24)
JEFE_REMINDER_HORAS=24

# ──────────────────────────────────────────────────────────────────────────────
# MIGRACIÓN A OPCIÓN B (jefes en base de datos):
#   Cuando dbo.MAE_CCOST tenga columnas EMAIL_JEFE y NOM_JEFE:
#   1. Ejecuta en MineDax:
#        ALTER TABLE dbo.MAE_CCOST ADD EMAIL_JEFE NVARCHAR(100) NULL;
#        ALTER TABLE dbo.MAE_CCOST ADD NOM_JEFE   NVARCHAR(200) NULL;
#        UPDATE dbo.MAE_CCOST SET EMAIL_JEFE='...', NOM_JEFE='...' WHERE COD_CCOST=...;
#   2. En controllers/solicitudesController.js, función _resolverEmailJefe():
#      - Descomentar el bloque "OPCIÓN B"
#      - Comentar el bloque "OPCIÓN A"
#   3. Eliminar las variables JEFE_CCOST_* de este archivo.
# ──────────────────────────────────────────────────────────────────────────────

# ============================================================================
# SHAREPOINT — Guardado automático de PDFs de solicitudes
# ============================================================================
SP_TENANT_ID=REEMPLAZAR-con-id-del-directorio-azure
SP_CLIENT_ID=REEMPLAZAR-con-id-de-la-aplicacion-azure
SP_CLIENT_SECRET=REEMPLAZAR-con-secreto-de-cliente
SP_DRIVE_ID=REEMPLAZAR-con-id-del-drive-de-sharepoint
SP_FOLDER_PATH=Solicitudes_TH
